# =============================================================================
# GlacioGuard AI — Environment Configuration Template
# Copy this file to `.env` and populate credentials as needed.
# Secrets are read exclusively on the backend and are never exposed to the client.
# =============================================================================

GG_APP_NAME="GlacioGuard AI"
GG_ENVIRONMENT="development"

# Database Configuration
# Production (PostgreSQL + PostGIS via Docker or managed instance):
# GG_DATABASE_URL="postgresql+psycopg2://glacioguard:glacioguard_secret@localhost:5432/glacioguard"
# Local development fallback (SQLite with GeoJSON spatial serialization):
GG_DATABASE_URL="sqlite:///./data/glacioguard.db"

# Storage directory for raw DEMs, composites, uploads, checkpoints, and PDF reports
GG_DATA_DIR="./data"

# Google Earth Engine Authentication (Optional — STAC open-data COGs work without credentials)
# 1. Service account authentication (recommended for server deployment):
GG_GEE_PROJECT=""
GG_GEE_SERVICE_ACCOUNT=""
GG_GEE_PRIVATE_KEY_FILE=""
GG_GEE_DRIVE_FOLDER="GlacioGuard_exports"
# 2. Interactive user authentication: run `earthengine authenticate` and set GG_GEE_PROJECT above.

# Open STAC & Infrastructure Endpoints
GG_PC_STAC_URL="https://planetarycomputer.microsoft.com/api/stac/v1"
GG_EARTH_SEARCH_URL="https://earth-search.aws.element84.com/v1"
GG_OVERPASS_URL="https://overpass-api.de/api/interpreter"

# Metric Coordinate Reference System (WGS 84 / UTM Zone 44N for Uttarakhand)
GG_UTM_EPSG=32644

# CORS Allowed Origins
GG_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

